# Gemini API key 
GOOGLE_API_KEY=

# Google Cloud project ID
GCP_PROJECT=

# Gemini model to use 
GEMINI_MODEL=gemini-3.8-flash

# Fallback model, used automatically when the primary model fails or times out
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: request timeouts in seconds
# LLM_TIMEOUT_S=30
# FALLBACK_TIMEOUT_S=60
# CLASSIFIER_TIMEOUT_S=10
# QUERY_TIMEOUT_S=30

# Optional: largest query BigQuery may scan, in bytes
# MAX_QUERY_BYTES=1000000000

# Optional: where saved reports and the audit log are stored
# APP_DB_PATH=data/app.db

# Optional: where traces and logs are written
# LOG_DIR=logs

# Optional: log level for logs/agent.log
# LOG_LEVEL=INFO

# Optional: minimum seconds between model calls. The free tier allows 15 requests per minute per model.
# LLM_MIN_INTERVAL_S=4

# Optional: secret that keeps pseudonymous customer keys stable across restarts.
# Without it, keys change every time the CLI starts.
# CUSTOMER_KEY_SALT=

# Optional: prices for the cost estimate in /stats and /trace. Illustrative: check current price lists.
# LLM_USD_PER_MILLION_TOKENS=0.50
# BIGQUERY_USD_PER_TIB=6.25
