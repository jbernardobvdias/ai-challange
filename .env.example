# Gemini API key 
GOOGLE_API_KEY=

# Google Cloud project ID
GCP_PROJECT=

# Gemini model to use 
GEMINI_MODEL=gemini-3.8-flash

# Fallback model, used automatically when the primary model fails or times out
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional: request timeouts in seconds
# LLM_TIMEOUT_S=30
# FALLBACK_TIMEOUT_S=60
# CLASSIFIER_TIMEOUT_S=10
# QUERY_TIMEOUT_S=30

# Optional: largest query BigQuery may scan, in bytes
# MAX_QUERY_BYTES=1000000000

# Optional: where saved reports and the audit log are stored
# APP_DB_PATH=data/app.db

# Optional: where traces and logs are written
# LOG_DIR=logs
